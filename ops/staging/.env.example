POSTGRES_USER=staging
POSTGRES_PASSWORD=replace-with-random-secret
POSTGRES_DB=homefinance_staging
MINIO_ROOT_USER=staging
MINIO_ROOT_PASSWORD=replace-with-random-secret
JWT_SECRET=replace-with-random-secret
CORS_ORIGIN=http://YOUR_VPS_IP
COMPOSE_PROJECT_NAME=homefinance-staging
POSTGRES_VOLUME_NAME=homefinance-staging-postgres-data
REDIS_VOLUME_NAME=homefinance-staging-redis-data
MINIO_VOLUME_NAME=homefinance-staging-minio-data
# A future HTTPS/domain setup must expose a deliberate object-download path.
MINIO_PUBLIC_ENDPOINT=YOUR_VPS_IP
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
BACKEND_IMAGE=ghcr.io/qzsama/homefinance/backend@sha256:...
FRONTEND_IMAGE=ghcr.io/qzsama/homefinance/frontend@sha256:...
MOCK_AI_IMAGE=ghcr.io/qzsama/homefinance/mock-ai@sha256:...
